# ─── PostgreSQL (Neon) ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── MySQL CRM (requires VPN) ────────────────────────────────────────────────
# Phase 1: run scripts/sync-crm.ts locally while VPN is active
# Phase 2: deploy to a VPS with OpenVPN — no code changes needed
CRM_DATABASE_URL=mysql://user:password@crm.arbatravel.com:3306/attcrm

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ─── Google (Ads + Search Console share one OAuth app) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
SEARCH_CONSOLE_SITE_URL=https://arbatravel.com/

# ─── Meta Ads ─────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=act_
META_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/integrations/meta/callback

# ─── TikTok Ads ───────────────────────────────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ADVERTISER_ID=
TIKTOK_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/integrations/tiktok/callback

# ─── Cron secret (shared by Vercel Cron Jobs and manual triggers) ─────────────
CRON_SECRET=generate-with-openssl-rand-hex-32
