# =====================================================================
# Cruise inventory sources
# ---------------------------------------------------------------------
# Copy this file to .env.local (which is git-ignored) and fill in real
# values on each machine that runs the app. Never commit .env.local.
# All three adapters currently run in mock mode if these vars are blank.
# =====================================================================

# --- Source 1: TravelB2B Malaysia ------------------------------------
# Status: awaiting API access.
# Action: email partners@travelb2b.my and request an XML/JSON feed or
# affiliate data export. Once granted, set the values below and update
# src/lib/inventory/travelb2b/adapter.ts to call the real endpoint.
TRAVELB2B_API_URL=
TRAVELB2B_API_KEY=

# --- Source 2: World Cruise Centre ------------------------------------
# Status: awaiting affiliate feed.
# Action: contact enquiries@worldcruisecentre.com.my requesting an
# accredited-agent data feed or booking API.
WORLDCRUISECENTRE_API_URL=
WORLDCRUISECENTRE_API_KEY=

# --- Source 3: Hwajing (Cruqo platform) -------------------------------
# Status: awaiting API access.
# Action: contact Hwajing directly, or the Cruqo platform operator, to
# request a partner API key for inventory and booking.
HWAJING_API_URL=
HWAJING_API_KEY=
