# =====================================================================
# Cruise inventory sources
# ---------------------------------------------------------------------
# Copy this file to .env.local (which is git-ignored) and fill in real
# values on each machine that runs the app. Never commit .env.local.
#
# Each adapter operates in one of three modes, chosen automatically:
#   1. If *_API_URL and *_API_KEY are set, the adapter calls the
#      supplier API directly (preferred, not yet available).
#   2. If *_USERNAME and *_PASSWORD are set, the adapter falls back to
#      a Playwright scraper using the agent portal login (testing).
#   3. Otherwise, the adapter returns mock fixtures (default).
# =====================================================================

# --- Source 1: TravelB2B Malaysia (https://www.travelb2b.my) ----------
TRAVELB2B_API_URL=
TRAVELB2B_API_KEY=
TRAVELB2B_USERNAME=
TRAVELB2B_PASSWORD=

# --- Source 2: World Cruise Centre (https://www.worldcruisecentre.com.my)
WORLDCRUISECENTRE_API_URL=
WORLDCRUISECENTRE_API_KEY=
WORLDCRUISECENTRE_USERNAME=
WORLDCRUISECENTRE_PASSWORD=

# --- Source 3: Hwajing on Cruqo (https://hwajing.cruqo.com) -----------
HWAJING_API_URL=
HWAJING_API_KEY=
HWAJING_USERNAME=
HWAJING_PASSWORD=

# --- Playwright runtime tuning ----------------------------------------
# Set to "false" to see the browser window while scraping (debug mode).
PLAYWRIGHT_HEADLESS=true
# Where to persist supplier session cookies between runs.
# Default: .playwright-state (git-ignored).
PLAYWRIGHT_STATE_DIR=
